# TypeSafe AI Cloud Configuration (Required for cloud live inference)
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_TIMEOUT_SECONDS=4.0
USE_TYPESAFE_API=True

# Optional Local Fallback Settings (if running local llama-server)
# AGRI_LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080
# AGRI_USE_FAST_DECISION_ENGINE=False
